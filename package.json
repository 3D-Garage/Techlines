{
  "name": "techlines",
  "version": "1.0.0",
  "description": "The backend for techlines",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "client": "npm run start --prefix client",
    "server": "node server/index.js",
    "app": "concurrently \"npm run server\" \"npm run client\"",
    "test:server": "node server/scripts/run-tests.js",
    "test:browser": "playwright test",
    "test:paypal:sandbox": "node server/scripts/verify-sandbox-checkout.js",
    "test:server:coverage": "node --test --experimental-test-coverage server/__tests__/*.test.js",
    "seed": "node server/scripts/seed.js",
    "setup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dev.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balint-szabox/techlines.git"
  },
  "author": "Szabó Bálint",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/balint-szabox/techlines/issues"
  },
  "homepage": "https://github.com/balint-szabox/techlines#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.0.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "react-scripts": "^5.0.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
