MONGO_URI=mongodb://127.0.0.1:27017/techlines
TOKEN_SECRET=replace-with-a-long-random-development-secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
CORS_ORIGIN=http://localhost:3000
PORT=5000

# Custom 3D print requests. Relative upload paths resolve from the repository root.
# Keep this directory private, persist it across deployments, and back it up with MongoDB.
CUSTOM_ORDER_UPLOAD_DIR=private-uploads/custom-orders
CUSTOM_ORDER_MAX_FILE_SIZE_MB=20
# Aggregate upload storage in MiB; reserve one maximum-size file for each active upload.
# Use only one API process per upload directory (quota accounting is process-local).
CUSTOM_ORDER_MAX_STORAGE_MB=1024
# Bound the number of stored files and active uploads, including tiny files.
CUSTOM_ORDER_MAX_FILES=10000
# Expired files are deleted at startup and periodically; order records remain in MongoDB.
# Retention applies to existing files and to requests in every status.
CUSTOM_ORDER_RETENTION_DAYS=30
CUSTOM_ORDER_CLEANUP_INTERVAL_MINUTES=60
CUSTOM_ORDER_ADMIN_EMAIL=
APP_BASE_URL=http://localhost:3000
# SMTP_FROM must be a single email address. Credentials are optional for a local SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SEED_ADMIN_NAME=Local Admin
SEED_ADMIN_EMAIL=admin@3dgarage.local
SEED_ADMIN_PASSWORD=replace-with-a-local-development-password
