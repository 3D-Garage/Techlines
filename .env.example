MONGO_URI=mongodb://127.0.0.1:27017/techlines?replicaSet=rs0
TOKEN_SECRET=replace-with-a-long-random-development-secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
CORS_ORIGIN=http://localhost:3000
PORT=5000

# Custom 3D print requests. Relative upload paths resolve from the repository root.
# Keep this directory private, persist it across deployments, and back it up with MongoDB.
CUSTOM_ORDER_UPLOAD_DIR=private-uploads/custom-orders
CUSTOM_ORDER_MAX_FILE_SIZE_MB=20
CUSTOM_ORDER_ADMIN_EMAIL=
APP_BASE_URL=http://localhost:3000
# SMTP_FROM must be a single email address. Credentials are optional for a local SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SEED_ADMIN_NAME=Local Admin
SEED_ADMIN_EMAIL=admin@3dgarage.local
SEED_ADMIN_PASSWORD=replace-with-a-local-development-password
